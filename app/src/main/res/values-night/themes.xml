<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark mode: mesmas cores do light — app não usa dark theme personalizado -->
    <style name="Base.Theme.MyApplication" parent="Theme.Material3.Light">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primary_light</item>
        <item name="colorOnPrimaryContainer">@color/primary_dark</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/accent_light</item>
        <item name="colorTertiary">@color/gold</item>
        <item name="colorError">@color/danger</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/border</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="actionBarStyle">@style/Widget.EstudoMais.ActionBar</item>
        <item name="actionBarTheme">@style/ThemeOverlay.Material3.Dark.ActionBar</item>
        <item name="materialButtonStyle">@style/Widget.EstudoMais.Button</item>
        <item name="textInputStyle">@style/Widget.EstudoMais.TextInput</item>
        <item name="floatingActionButtonStyle">@style/Widget.EstudoMais.FAB</item>
        <item name="materialCardViewStyle">@style/Widget.EstudoMais.Card</item>
    </style>
</resources>
