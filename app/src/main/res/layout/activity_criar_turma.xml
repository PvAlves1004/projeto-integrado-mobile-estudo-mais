<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nome da turma *"
            android:textSize="12sp"
            android:textColor="#666666" />

        <EditText
            android:id="@+id/editNomeTurma"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:inputType="text|textCapWords"
            android:maxLines="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Disciplina *"
            android:textSize="12sp"
            android:textColor="#666666" />

        <EditText
            android:id="@+id/editDisciplina"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:inputType="text|textCapWords"
            android:maxLines="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ano/Série (ex: 1º Ano, 2º Ano) *"
            android:textSize="12sp"
            android:textColor="#666666" />

        <EditText
            android:id="@+id/editSemestre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:inputType="text|textCapWords"
            android:maxLines="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PROFESSORES"
            android:textSize="12sp"
            android:textColor="#666666"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSelecionarProfessores"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#E0E0E0"
            android:text="Selecionar professores"
            android:textColor="#212121" />

        <TextView
            android:id="@+id/tvProfessoresSelecionados"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:layout_marginTop="4dp"
            android:text="Nenhum selecionado"
            android:textColor="#999999"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ALUNOS"
            android:textSize="12sp"
            android:textColor="#666666"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSelecionarAlunos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#E0E0E0"
            android:text="Selecionar alunos"
            android:textColor="#212121" />

        <TextView
            android:id="@+id/tvAlunosSelecionados"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:layout_marginTop="4dp"
            android:text="Nenhum selecionado"
            android:textColor="#999999"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnSalvarTurma"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#008080"
            android:text="Criar Turma"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

    </LinearLayout>

</ScrollView>
